<display version="2.0.0">
  <name>AWA zone1-&gt;zone2 twin</name>
  <width>1306</width>
  <height>1048</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>AWA zone1 -&gt; zone2 twin (click an element to edit it)</text>
    <x>30</x><y>10</y><width>700</width><height>28</height>
    <font><font family="Liberation Sans" style="BOLD" size="16.0"/></font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>StatusLabel</name>
    <text>Twin:</text>
    <x>1046</x><y>12</y><width>50</width><height>22</height>
    <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
  </widget>
  <widget type="led" version="2.0.0">
    <name>StatusLed</name>
    <pv_name>pva://$(P=AWA:SIM:)STATUS</pv_name>
    <x>1096</x><y>12</y><width>20</width><height>20</height>
    <off_color><color red="0" green="170" blue="0"/></off_color>
    <on_color><color red="255" green="150" blue="0"/></on_color>
  </widget>
